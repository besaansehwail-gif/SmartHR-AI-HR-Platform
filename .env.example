# SmartHR AI Assistant - language model configuration
#
# Copy this file to `.env` in the repository root and fill in a key. `.env` is
# read at import time by app/ai/config.py and must never be committed.
#
# With no key present the assistant still runs: it resolves the question to a
# tool, queries PostgreSQL and returns the real result, labelled as a direct
# tool result rather than a generated answer.

# Which provider to call. Supported: anthropic, openai
SMARTHR_LLM_PROVIDER=anthropic

# The API key. ANTHROPIC_API_KEY / OPENAI_API_KEY are also accepted when they
# match the provider above, so a machine that already exports one needs no
# extra setup.
SMARTHR_LLM_API_KEY=

# Optional. Defaults: claude-sonnet-5 (anthropic), gpt-4o-mini (openai)
# SMARTHR_LLM_MODEL=claude-sonnet-5

# Optional overrides.
# SMARTHR_LLM_BASE_URL=
# SMARTHR_LLM_MAX_TOKENS=1024
# SMARTHR_LLM_TIMEOUT=30


# ===========================================================================
# Email - the AI Interview System notifies applicants by email
# ===========================================================================
#
# SmartHR sends over SMTP using the Python standard library; there is no
# third-party mail dependency and no API key for a mail service.
#
# WITH NOTHING SET HERE NOTHING IS SENT. Every send reports
# status "not_configured", the HR screen says the applicant has not been
# emailed, and the message is written to uploads/outbox/ so it can be read.
# SmartHR does not simulate delivery.
#
# Set at minimum SMARTHR_SMTP_HOST and SMARTHR_EMAIL_FROM to enable sending.

# SMARTHR_SMTP_HOST=smtp.example.com
# SMARTHR_SMTP_PORT=587
# SMARTHR_SMTP_USERNAME=
# SMARTHR_SMTP_PASSWORD=
# SMARTHR_SMTP_STARTTLS=true
# SMARTHR_SMTP_SSL=false
# SMARTHR_EMAIL_FROM=recruitment@example.com
# SMARTHR_EMAIL_FROM_NAME=SmartHR
# SMARTHR_EMAIL_OUTBOX_DIR=uploads/outbox

# Where an applicant should go to act on an email. Used in the message body.
# SMARTHR_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Social Hub
# ---------------------------------------------------------------------------
# The People directory hides `@smarthr.test` accounts - they are fixtures the
# test scripts create, not colleagues. Set this to true only if you need to see
# them (scripts/test_social_hub.py sets it for its own server).
SMARTHR_SOCIAL_SHOW_TEST_ACCOUNTS=false

# AI moderation for Social Hub posts, comments and stories. On by default.
#
# When it is on, every new piece of content is classified by the configured
# language model before it appears, and anything flagged is held for Admin/HR
# review rather than published. It FAILS CLOSED: if no model is configured, or
# the model is unreachable or returns something unusable, the content is held
# for review rather than published unchecked. Nothing is ever deleted
# automatically - "removed" is a status a person sets.
#
# The consequence of fail-closed is worth knowing before you turn it on: on a
# deployment with NO language model configured, every post goes to the review
# queue. Set this to false there, and the Social Hub behaves exactly as it did
# before moderation existed.
#
# scripts/test_social_hub.py sets it to false for its own server, so that
# suite does not depend on a third party being reachable.
SMARTHR_SOCIAL_MODERATION=true

# The reusable celebration graphic the AI Employee Celebration post carries.
# Created by `python -m scripts.seed_celebration_image`, stored through the
# Social Hub's own image storage and served by its own media route. It is an
# abstract banner, never a photograph of a person: SmartHR holds no employee
# photograph, and a stock face beside a real colleague's name would be a
# fabricated identity. Unset this and celebrations are text only.
SMARTHR_CELEBRATION_IMAGE=

# AI Interview - LiveKit Cloud (the voice interviewer).
#
# Put these three in `.env.local` (git-ignored), NOT here. The AI Interview
# reads, in order: real environment -> .env.local -> .env. The rest of
# SmartHR reads only the environment and .env, so this does not change which
# LLM key the assistant, agents or moderation use.
#
# The safest way to fill them from a LiveKit Cloud project is the LiveKit CLI,
# pointed at the three-line template so nothing else is merged in:
#
#   lk app env -w -e livekit.env.example --project SmartHR-AI-Interview
#
# The interviewer's model is fixed to openai/gpt-4o through LiveKit Inference,
# so no OpenAI key is needed for the voice path. Optional overrides below
# change only speech-to-text / text-to-speech.
#
# LIVEKIT_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
#
# Speech-to-text language: en | ar | multi (multi = detect per utterance; a
# regional code such as en-US also works). Default en. Arabic speech on "en"
# comes back as Latin-letter nonsense, so an Arabic-speaking deployment must
# set ar. Do NOT use multi for Arabic on deepgram/nova-3: measured, it returned
# English words / Latin transliteration (scripts/check_stt_arabic.py).
# SMARTHR_INTERVIEW_LANGUAGE=en
# Speech-to-text model. Measured on an Arabic clip: deepgram/nova-3 + ar got
# ~80% of words right; speechmatics/enhanced + ar got all of them. For Arabic
# interviews use SMARTHR_INTERVIEW_LANGUAGE=ar with speechmatics/enhanced.
# The worker warns at startup when language is ar/multi on deepgram/nova-3.
# SMARTHR_INTERVIEW_STT_MODEL=deepgram/nova-3
# SMARTHR_INTERVIEW_TTS_MODEL=cartesia/sonic-3
# SMARTHR_INTERVIEW_TOKEN_TTL_MINUTES=10
#
# Optional Stage 5 visual context. OFF by default; when enabled, one latest
# applicant camera frame may be attached to GPT-4o for an accepted answer turn.
# Enable only for an explicitly approved visual use case.
# SMARTHR_INTERVIEW_CAMERA_VISION=false
#
# Debug capture of each applicant turn - DEVELOPMENT ONLY, NEVER IN PRODUCTION
# (the production worker refuses to start with it on). Writes the applicant's
# audio and transcript to debug_captures/ (git-ignored). false | true (each
# turn's audio trimmed to the speech + a JSON of transcript, label, reply and
# timings) | raw (also the untrimmed audio). Delete the folder after use.
# SMARTHR_INTERVIEW_DEBUG_CAPTURE=false
